# Phase 7: model binaries and training checkpoints stay out of git (metadata, records and checksums are committed)
models/**/*.pt
models/**/*.pth
experiments/**/checkpoints/
experiments/**/*.tmp
experiments/**/diagnostics/
# Phase 8: development-only experimental inference outputs (never committed)
