# Phase 10: persistence browser test outputs (screenshots, downloads); only the results file is committed
tests/ui/p10/*
!tests/ui/p10/persistence_e2e_results.json
# Phase 11: review/report browser test outputs (screenshots, downloaded PDFs); only the results file is committed
tests/ui/p11/*
!tests/ui/p11/results.json

# Phase 13: negative images (ImageNet samples, generated negatives); manifests are committed
