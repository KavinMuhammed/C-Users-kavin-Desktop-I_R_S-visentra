{
  "schema": "visiontra.detection_experiment/1",
  "experiment_id": "VT-EXP-004",
  "description": "Three-class baseline (crack, dent, corrosion), YOLOX-Tiny 416 px, COCO-pretrained; VT-DS-001 (crack, dent) + VT-DS-002 (Rust→corrosion) under CMAP-001 v2 (product-owner provisional mapping, 2026-10-17).",
  "dataset": {
    "prep_id": "VT-PREP-001",
    "datasets": [
      "VT-DS-001",
      "VT-DS-002"
    ],
    "splits": {
      "train": "datasets/splits/VT-PREP-001/train.csv",
      "valid": "datasets/splits/VT-PREP-001/valid.csv",
      "test": "datasets/splits/VT-PREP-001/test.csv"
    },
    "class_mapping": "datasets/config/class_mapping.json",
    "mapping_statuses_allowed": [
      "ACCEPTED",
      "PROVISIONAL_ACCEPTED"
    ],
    "target_classes": [
      "crack",
      "dent",
      "corrosion"
    ],
    "train_sampling": "one_file_per_asset_per_epoch",
    "valid_subset": "one_file_per_asset",
    "test_subset": "eval_representatives"
  },
  "model": {
    "family": "YOLOX",
    "variant": "tiny",
    "input_size": [
      416,
      416
    ],
    "preprocessing": {
      "mode": "letterbox",
      "fill": 114,
      "colour_order": "BGR",
      "scale": "0-255, no mean/std normalisation (YOLOX convention)"
    },
    "pretrained": {
      "path": "models/pretrained/yolox_tiny_coco_0.1.1rc0.pth",
      "sha256": "9de513de589ac98bb92d3bca53b5af7b9acfa9b0bacb831f7999d0f7afaee8f0",
      "source_url": "https://github.com/Megvii-BaseDetection/YOLOX/releases/download/0.1.1rc0/yolox_tiny.pth",
      "licence": "Apache-2.0 (YOLOX repository licence; COCO-pretrained)",
      "trained_on": "MS COCO 2017 (80 classes)"
    }
  },
  "train": {
    "epochs": 24,
    "batch_size": 16,
    "seed": 20261011,
    "device": "cpu",
    "num_threads": 2,
    "optimizer": {
      "name": "sgd",
      "lr_per_img": 0.00015625,
      "momentum": 0.9,
      "weight_decay": 0.0005
    },
    "scheduler": {
      "name": "cosine",
      "warmup_epochs": 1,
      "min_lr_ratio": 0.05
    },
    "ema": true,
    "eval_every": 1,
    "selection_split": "valid",
    "early_stopping": {
      "metric": "AP50_95",
      "patience": 6
    },
    "checkpoint": {
      "last": "every epoch (resume state)",
      "best": "EMA weights of the best validation epoch"
    },
    "grad_clip_norm": 10
  },
  "augment": {
    "hflip": 0.5,
    "vflip": 0.0,
    "scale": [
      0.8,
      1.2
    ],
    "translate": 0.1,
    "hsv": {
      "h": 0.0,
      "s": 0.2,
      "v": 0.25
    },
    "mosaic": 0,
    "mixup": 0,
    "note": "No vertical flip: the training files already include Roboflow's rotation augmentations; adding vertical flips would make ceiling/floor lighting cues inconsistent without evidence they help. No hue shift, mosaic or mixup (AUG-02)."
  },
  "eval": {
    "nms_iou": 0.65,
    "score_floor": 0.001,
    "max_det": 100,
    "match_iou": 0.5,
    "report_threshold": 0.25
  },
  "output_dir": "experiments/VT-EXP-004"
}
