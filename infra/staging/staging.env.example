# VisionTra STAGING configuration. Copy to <install dir>/.env on the staging host (the app reads it from there),
# fill the two CHANGE_ME values, and restrict the file to the service account (Linux: chmod 600; Windows: remove
# "Users" from its permissions). Never copy a real .env back into the project or a bundle.
# Reference: docs/STAGING_PLAN.md, docs/DEPLOYMENT_RUNBOOK.md §2.

# Production behaviour: refuses to start without JWT_SECRET; disables /api/docs, demo samples and experimental detection.
VISENTRA_ENV=production
# python -c "import secrets;print(secrets.token_urlsafe(48))"  — unique to staging, never reused in production
JWT_SECRET=CHANGE_ME

# Persistent data on the staging host: SQLite database, objects, pre-migration backups. Absolute path, outside the install dir.
#   Linux:   /var/lib/visiontra/data        Windows: D:\visiontra-staging\data
VISENTRA_DATA_DIR=CHANGE_ME
# DATABASE_URL unset = SQLite in VISENTRA_DATA_DIR (the verified configuration). PostgreSQL is untested.
STORAGE_BACKEND=local

# HTTPS through the TLS proxy: Secure cookies and HSTS.
COOKIE_SECURE=true
# Empty: the API serves the UI itself (same origin).
CORS_ORIGINS=

# Accounts are created by the operator (scripts/create_user.py); no self-service sign-up on staging.
REGISTRATION_OPEN=false
# No mail transport: keep reset links out of the log (an operator resets passwords with scripts/create_user.py --reset).
PASSWORD_RESET_LINK_IN_LOG=false

# The operational models, pinned (do not use "auto" on staging or production).
VISIONTRA_INSPECTION_MODEL=VT-DET-0002
VISIONTRA_DOMAIN_GATE=VT-GATE-0002

# Analysis, OCR and reports run in the API process (there is no separate worker in this build).
WORKER_MODE=inline
# 0 = PyTorch default (all cores). On a shared VM set e.g. 2.
TORCH_THREADS=0

# Upload limits (the TLS proxy must allow at least 30 MB request bodies; the app enforces these).
INSPECTION_MAX_UPLOAD_MB=5
MAX_IMAGE_PIXELS=60000000

# Online dataset import is a development feature; keep it off on staging.
FEATURE_URL_SOURCES=false
ALLOW_PRIVATE_NETWORK=false
ALLOW_INSECURE_HTTP=false

LOG_LEVEL=INFO
