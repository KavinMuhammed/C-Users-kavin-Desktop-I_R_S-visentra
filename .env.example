# ---------------------------------------------------------------- Visentra configuration
# Copy to .env and adjust. Never commit a real .env.
VISENTRA_ENV=development            # development | production
VISENTRA_DATA_DIR=./data            # SQLite db, local object store and models (development)

# Database: PostgreSQL in production; SQLite is used when DATABASE_URL is unset.
# DATABASE_URL=postgresql+psycopg://visentra:CHANGE_ME@localhost:5432/visentra

# Session signing secret (required in production). Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
SESSION_DAYS=7
COOKIE_SECURE=false                 # set true behind HTTPS
CORS_ORIGINS=                       # comma-separated; leave empty when the UI is served by the API

# Object storage: local (default) or s3 (S3 / MinIO)
STORAGE_BACKEND=local
STORAGE_ENDPOINT=                   # e.g. http://localhost:9000 for MinIO
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=visentra
MODEL_STORAGE_PATH=./data/models    # used when STORAGE_BACKEND=local

# Background jobs: inline = worker threads inside the API process; external = run `python -m visentra_api.worker`
WORKER_MODE=inline
WORKER_THREADS=1
TORCH_THREADS=0                     # 0 = PyTorch default

# Upload & safety limits
MAX_UPLOAD_MB=20
MAX_ZIP_MB=500
MAX_ZIP_FILES=20000
MAX_IMAGE_PIXELS=60000000
MIN_IMAGE_SIDE=32

# Online data collection (SSRF protection): HTTPS only, these hosts and their subdomains only.
ALLOWED_SOURCE_HOSTS=datasets-server.huggingface.co,huggingface.co,hf.co,cdn-lfs.huggingface.co,cdn-lfs.hf.co,cas-bridge.xethub.hf.co,upload.wikimedia.org,storage.googleapis.com,raw.githubusercontent.com
ALLOW_PRIVATE_NETWORK=false         # never enable in production
ALLOW_INSECURE_HTTP=false
REGISTRATION_OPEN=true
LOG_LEVEL=INFO

# Worker liveness & reconciliation
JOB_STALE_SECONDS=120               # running job with no heartbeat this long → failed with WORKER_LOST
WORKER_STALE_SECONDS=60             # worker heartbeat older than this → reported offline by /api/health/ready
MAX_JOB_ATTEMPTS=1                  # training is never silently resumed mid-run

# Readiness policy (versioned in code; minimum images per class can be tuned)
READINESS_MIN_PER_CLASS=15

# Devices
DEVICE_HEARTBEAT_TIMEOUT=60         # seconds without a heartbeat before a device is OFFLINE

# Feature flags (true/false)
FEATURE_DEVICES=true
FEATURE_BATCH_INFERENCE=true
FEATURE_URL_SOURCES=true
FEATURE_EXPLANATIONS=true
FEATURE_REALTIME=true

# ---- Phase 8: experimental, development-only detection (docs/PHASE_8_SECURITY.md) ----
# Off by default. Refused in production whatever these say. Needs PyTorch and the VT-DET-0001 weights.
VISIONTRA_EXPERIMENTAL_DETECTION=false
# Comma-separated account emails allowed to run it:
VISIONTRA_EXPERIMENTAL_USERS=
# false = only clients connecting from 127.0.0.1 / ::1:
VISIONTRA_EXPERIMENTAL_ALLOW_REMOTE=false
VISIONTRA_EXPERIMENTAL_TIMEOUT_S=30
VISIONTRA_EXPERIMENTAL_MAX_PIXELS=40000000
# VISIONTRA_DETECTION_MODELS_DIR=models/detection

# ---- Phase 10: persisted inspections (docs/PHASE_10_DATABASE_IMPLEMENTATION.md) ----
# Upload policy for saved inspections (the browser takes the same values from /api/system/capabilities)
INSPECTION_MIN_SIDE=320             # shorter side, px, after EXIF orientation
INSPECTION_MAX_SIDE=12000           # longer side, px
INSPECTION_RATE_PER_MIN=30          # creations per user per minute (in-process limiter)
# Write intents older than this are resolved by scripts/reconcile_storage.py
STORAGE_INTENT_GRACE_S=900
# Before any schema upgrade the API copies a SQLite database to <VISENTRA_DATA_DIR>/backups/ automatically.
# On PostgreSQL run pg_dump yourself first (docs/PHASE_10_RECOVERY.md).

# Phase 12: synthetic SAMPLE inspection records in the browser (demonstration only). Ignored (always off) when VISENTRA_ENV=production.
VISIONTRA_DEMO_SAMPLES=true
# Optional: where the read-only dataset views look for datasets/ (default: the repository's datasets/ folder)
# VISIONTRA_DATASETS_ROOT=
